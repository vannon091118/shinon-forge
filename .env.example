[TEMPLATE]
# Vorlage für die Umgebungsvariablen von Shinon Forge.
#
# WIE SCHLÜSSEL HIER WIRKLICH FLIESSEN (am Baum gemessen):
# - `npm run dev` startet `DSH_HOME=$PWD dsh --profile shinon` (package.json).
#   DSH lädt dabei die Projekt-`.env` im Repo-Root als erste Schicht neben der
#   Prozessumgebung; der Key-Router liest zusätzlich die Benutzer-`.env`.
#   Drei Schichten: Prozess, Projekt-`.env`, Benutzer-`.env`
#   (siehe packages/key-router/index.js).
# - Die echten Werte stehen in der UNGETRACKTEN `.env` im Repo-Root
#   (`chmod 600`, nie committen — `.gitignore` blockt `.env` und erlaubt nur
#   diese Vorlage). Es gibt in diesem Repo KEIN Infisical-Setup.
#
# NUR NAMEN UND PLATZHALTER — NIEMALS EINEN ECHTEN SCHLÜSSEL COMMITTEN.
# Jeder Name unten ist per `grep -rn <NAME> profiles packages` im Baum belegt.

# Standard-Route der Profile headless + shinon (apiKeyEnv in cordis.patch.yml).
SHINON_API_KEY=

# Route agnes/* (shinon + mobile) und Fallback des Prompter-One-Shots.
AGNES_API_KEY=

# Anbieter-Einträge des Profils shinon (je ein llm-pi-ai-Eintrag mit apiKeyEnv).
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

# Eigene Route des Prompter-One-Shots (providerKeyEnv, packages/prompter).
# Fehlt er, fällt der Host auf die agnes-Route zurück.
PROMPTER_API_KEY=

# Standard-Präfix des Key-Routers für zusätzliche Pool-Schlüssel
# (`<prefix>` und `<prefix>_*`, packages/key-router).
DEEPSEEK_API_KEY=
