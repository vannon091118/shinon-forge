{
  "name": "@shinon/forge",
  "version": "0.4.0",
  "description": "Shinon Forge - Built on DSH. Forged differently.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "shinon": "bin/shinon.mjs"
  },
  "scripts": {
    "dev": "DSH_HOME=$PWD dsh --profile shinon",
    "dev:web": "DSH_HOME=$PWD dsh --profile shinon --no-open --trusted-host localhost --trusted-host 127.0.0.1 --port 3085",
    "open": "node scripts/open.mjs",
    "start": "node bin/shinon.mjs",
    "desktop:launcher": "node scripts/desktop-launcher.mjs",
    "desktop:launcher:uninstall": "node scripts/desktop-launcher.mjs --uninstall",
    "verify:panel": "node scripts/panel-check.mjs",
    "verify:install": "node scripts/install-user.mjs selftest",
    "build": "node scripts/build.mjs",
    "branding": "node scripts/branding-check.mjs",
    "idioms": "node scripts/sync-idioms.mjs",
    "idioms:check": "node scripts/sync-idioms.mjs --check",
    "zahlen:sync": "node scripts/run-with-node.mjs scripts/sync-zahlen.mjs",
    "zahlen:check": "node scripts/run-with-node.mjs scripts/sync-zahlen.mjs --check",
    "test": "node scripts/run-with-node.mjs node --test packages/codingmon/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/scoring/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/token-usage/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/prompter/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/narrative/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/popup/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/key-router/test/*.test.mjs && node scripts/run-with-node.mjs node --test packages/traceability/test/*.test.mjs && node scripts/run-with-node.mjs scripts/shinon-test.mjs && node scripts/run-with-node.mjs scripts/validate-test.mjs && node scripts/run-with-node.mjs scripts/pack-test.mjs && node scripts/run-with-node.mjs scripts/shinon-profile-test.mjs",
    "test:token": "node scripts/run-with-node.mjs node --test packages/token-usage/test/*.test.mjs",
    "test:hook": "node scripts/run-with-node.mjs packages/hook/test/replay.test.mjs && node scripts/run-with-node.mjs node --test scripts/gate/tests/hook-pre-step.test.mjs",
    "test:codingmon": "node scripts/run-with-node.mjs node --test packages/codingmon/test/*.test.mjs",
    "test:scoring": "node scripts/run-with-node.mjs node --test packages/scoring/test/*.test.mjs",
    "test:prompter": "node scripts/run-with-node.mjs node --test packages/prompter/test/*.test.mjs",
    "test:narrative": "node scripts/run-with-node.mjs node --test packages/narrative/test/*.test.mjs",
    "test:popup": "node scripts/run-with-node.mjs node --test packages/popup/test/*.test.mjs",
    "test:key-router": "node scripts/run-with-node.mjs node --test packages/key-router/test/*.test.mjs",
    "test:traceability": "node scripts/run-with-node.mjs node --test packages/traceability/test/*.test.mjs",
    "notes:check": "node scripts/notes-check.mjs",
    "gate": "node scripts/run-with-node.mjs scripts/gate/engine.mjs",
    "gate:local": "node scripts/run-with-node.mjs scripts/gate/engine.mjs --local",
    "gate:full": "node scripts/run-with-node.mjs scripts/gate/engine.mjs --full",
    "gate:test": "node scripts/run-with-node.mjs node --test scripts/gate/tests/*.test.mjs",
    "commit:guard": "node scripts/commit-guard.mjs",
    "commit:check-file": "node scripts/commit-guard.mjs --file",
    "hooks:install": "node scripts/install-hooks.mjs",
    "profile:links": "node scripts/profile-links.mjs",
    "install:user": "node scripts/install-user.mjs",
    "backup:retention": "node scripts/backup-retention.mjs",
    "update": "node scripts/dsh-update.mjs",
    "stages": "node scripts/stages.mjs",
    "scale:check": "node scripts/scale-check.mjs",
    "typecheck": "node scripts/run-with-node.mjs scripts/gate/engine.mjs --only typescript",
    "dev:mobile": "DSH_HOME=$PWD node scripts/open.mjs --profile mobile --print-url",
    "test:mobile-profile": "node scripts/run-with-node.mjs scripts/mobile-profile-contract-test.mjs && node scripts/run-with-node.mjs scripts/shinon-profile-test.mjs --profile mobile"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.2.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@shinon/core": "workspace:*",
    "@shinon/events": "workspace:*",
    "@shinon/locale-de": "workspace:*",
    "@shinon/tooltip": "workspace:*",
    "@shinon/dashboard": "workspace:*",
    "@shinon/openapi": "workspace:*",
    "@shinon/better-errors": "workspace:*",
    "@shinon/token-usage": "workspace:*",
    "@shinon/persona": "workspace:*",
    "@shinon/markers": "workspace:*",
    "@shinon/hook": "workspace:*",
    "@shinon/prompter": "workspace:*",
    "@shinon/project-index": "workspace:*",
    "@shinon/task-router": "workspace:*",
    "@shinon/traceability": "workspace:*",
    "@shinon/codingmon": "workspace:*",
    "@shinon/key-router": "workspace:*",
    "@shinon/narrative": "workspace:*",
    "@shinon/shinon-forge": "workspace:*",
    "@shinon/popup": "workspace:*",
    "@shinon/scoring": "workspace:*",
    "typescript": "7.0.2",
    "@shinon/mobile": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vannon091118/shinon-forge.git"
  },
  "license": "MIT"
}
