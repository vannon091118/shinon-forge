{
  "name": "@shinon/forge",
  "version": "0.2.0",
  "description": "Shinon Forge - Built on DSH. Forged differently.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "DSH_HOME=$PWD dsh --profile shinon",
    "dev:web": "DSH_HOME=$PWD dsh --profile shinon --no-open --trusted-host localhost --trusted-host 127.0.0.1",
    "verify:panel": "node scripts/panel-check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/dsh-test.mjs && node scripts/validate-test.mjs && node scripts/pack-test.mjs && node scripts/dsh-profile-test.mjs",
    "test:hook": "node packages/hook/test/replay.test.mjs && node --test scripts/gate/tests/hook-pre-step.test.mjs",
    "gate": "node scripts/gate/engine.mjs",
    "gate:local": "node scripts/gate/engine.mjs --local",
    "gate:full": "node scripts/gate/engine.mjs --full",
    "gate:test": "node --test scripts/gate/tests/*.test.mjs",
    "commit:guard": "node scripts/commit-guard.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "update": "node scripts/dsh-update.mjs",
    "sync": "git fetch upstream && git merge upstream/main",
    "stages": "node scripts/stages.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@shinon/core": "workspace:*",
    "@shinon/events": "workspace:*",
    "@shinon/locale-de": "workspace:*",
    "@shinon/tooltip": "workspace:*",
    "@shinon/dashboard": "workspace:*",
    "@shinon/openapi": "workspace:*",
    "@shinon/better-errors": "workspace:*",
    "@shinon/token-usage": "workspace:*",
    "@shinon/persona": "workspace:*",
    "@shinon/markers": "workspace:*",
    "@shinon/hook": "workspace:*",
    "@shinon/codingmon": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vannon091118/shinon-forge.git"
  },
  "license": "MIT"
}
