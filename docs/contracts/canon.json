{
  "contract": "shinon.canon/v1",
  "name": "Kanon — ein Name, eine Schreibweise, eine Definition",
  "status": "IMPLEMENTED",
  "stand": "2026-10-20",
  "rules": [
    {
      "positive": "Jeder registrierte Name steht in seiner Definitionsdatei wortgleich; `canonIssues()` ist leer und das statische Gate zählt den Schritt als bestanden.",
      "forbidden": "Eine zweite Schreibweise eines registrierten Namens, ein Browser-Global `__shinon*` ohne Registry-Zeile und ein Vertrags-Literal außerhalb der drei Formen.",
      "fallback": "Fehlt die Registry oder parst sie nicht, endet der Schritt mit einem Befund — kein stiller Erfolg, keine geratene Ersatzform.",
      "error": "`canonIssues()` liefert je Befund Datei und Namen; das Gate färbt ihn als Fehler und endet Exit 1.",
      "trace": "Jede Registry-Zeile nennt `art`, `kanonisch` und `definiert_in`; der Befund nennt die Datei, in der die Abweichung steht.",
      "replay": "`node --test scripts/gate/tests/canon.test.mjs` fährt acht Fälle: den echten Baum, die Registry-Form und fünf Mutationen.",
      "invariant": "Ein Name ist genau einmal definiert; jede andere Stelle benutzt ihn wortgleich, nie in einer Variante."
    }
  ],
  "regel": "Jede Sache hat EINEN Namen und EINE Schreibweise. Verträge: `shinon.<bereich>/<sache>-v<N>`; ist die Sache der Bereich selbst, `shinon.<bereich>/v<N>`; ein Zustandsmarker trägt keine Version (`shinon.<bereich>/unloaded`). Browser-Globals sind camelCase (`__shinon<Bereich><Sache>`) — eine Client-Hälfte kann den Host nicht importieren, deshalb trägt jede das Literal, und dieser Schritt pinnt es.",
  "formen": {
    "vertrag": [
      "^shinon\\.[a-z0-9-]+/[a-z0-9-]+-v[0-9]+$",
      "^shinon\\.[a-z0-9-]+/v[0-9]+$",
      "^shinon\\.[a-z0-9-]+/unloaded$"
    ],
    "global": "^__shinon[A-Za-z0-9]+$",
    "dienst": "^shinon_[a-z0-9]+(?:_[a-z0-9]+)*$"
  },
  "namen": [
