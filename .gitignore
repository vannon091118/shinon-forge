node_modules/
dist/

# DSH runtime state — session logs, workspace state, telemetry id.
# Never commit: contains conversation content and local paths.
sessions/
storages/
.anonymous-user-id

# .shinon/ — der repo-lokale Laufzeitordner (Lebenszyklus: docs/ARCHITECTURE.md §5).
# NUR das abgeleitete Artefakt ist ignoriert: der Prompter baut es beim ersten
# Lauf selbst und kann es jederzeit neu bauen. Die Projekt-Kontextdatei daneben
# (.shinon/project-context.md) ist INHALT und wird getrackt; der Ordner selbst
# liegt als .shinon/.gitkeep im Baum, damit ein frischer Klon ihn hat.

# Runtime-Index des Prompters: absolute Pfade des jeweiligen Rechners und der
# volle Projektinhalt (gemessen 11 MB). Zustand, keine Quelle — aber NUR die
# Indexdatei: `.shinon/project-context.md` ist geschriebener Inhalt, den die
# Persona in den Prompt laedt, und bleibt sichtbar.
.shinon/prompter-index.json

# Credentials — never commit. Public repo!
.credentials.yaml

# Runtime- und Werkzeug-Reste (hinzugefuegt beim Artefakt-Aufraeumen).
logs/
*.log
**/.plugin-manager/logs/

# Python-Reste (das Repo ist Node-only, aber Werkzeuge fallen manchmal hierher).
__pycache__/
*.py[cod]
.pytest_cache/

# Freebuff workspace metadata.
.freebuff/

# OS- und Editor-Kram.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.orig
*.rej

# Umgebungen — nie committen. Vorlagen duerfen rein.
.env
.env.*
!.env.example

# Paket-/Testreste.
*.tgz
coverage/
.eslintcache
*.tsbuildinfo

# Session-Eval-Logs — nie committen (DSH-Session-Logs, Attachments, Tmp).
# Plan-Daten (.session-eval/*.md) bleiben absichtlich tracked.
.session-eval/logs-decompressed/
.session-eval/*.jsonl
.session-eval/*.zip
.session-eval/tmp/
attachments/
