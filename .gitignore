node_modules/
dist/

# DSH runtime state — session logs, workspace state, telemetry id.
# Never commit: contains conversation content and local paths.
sessions/
storages/
.anonymous-user-id

# Credentials — never commit. Public repo!
.credentials.yaml

# Runtime- und Werkzeug-Reste (hinzugefuegt beim Artefakt-Aufraeumen).
logs/
*.log
**/.plugin-manager/logs/

# Python-Reste (das Repo ist Node-only, aber Werkzeuge fallen manchmal hierher).
__pycache__/
*.py[cod]
.pytest_cache/

# Freebuff workspace metadata.
.freebuff/

# OS- und Editor-Kram.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.orig
*.rej

# Umgebungen — nie committen. Vorlagen duerfen rein.
.env
.env.*
!.env.example

# Paket-/Testreste.
*.tgz
coverage/
.eslintcache
*.tsbuildinfo

# pnpm-Reste: dieses Repo trackt keine und ruft pnpm nirgends auf (PLAN.md Schritt
# 3.5/A1). Ein Profil kann sie trotzdem zur Laufzeit bekommen — `dsh plugin add`
# schreibt ueber UPSTREAMs `initProfile` selbst eine pnpm-workspace.yaml ins
# Profilverzeichnis. Damit landet so eine Datei nie versehentlich im Commit.
pnpm-workspace.yaml
pnpm-lock.yaml
