node_modules/
dist/

# DSH runtime state — session logs, workspace state, telemetry id.
# Never commit: contains conversation content and local paths.
sessions/
storages/
.anonymous-user-id

# Repo-lokales DSH-Home (falls ein Lauf DSH_HOME in den Baum legt):
# Symlinks auf profiles/sessions/logs — Zustand, kein Inhalt.
dev-dsh-home/

# .shinon/ — der repo-lokale Inhaltsordner (Lebenszyklus: `AGENTS.md`).
# Hier liegt nur noch INHALT: `.shinon/project-context.md` (Persona),
# `.shinon/blocks.learned.json` (gelernte Bausteine). Der Laufzeit-Index des
# Prompters ist entfallen; einen Index fuehrt allein der Project Index, und der
# liegt außerhalb des Baums. Der Ordner selbst liegt als .shinon/.gitkeep im
# Baum, damit ein frischer Klon ihn hat.

# Der Blueprint-Kit zum CodingMon-50-Rework (Plan, Specs, ArtPack mit 50
# Creature-SVGs, Katalogseiten, Kontaktboegen, PNG-Vorschauen) liegt als
# SCRATCH-Material lokal: die SVGs sind die Quelle fuer die spaetere
# Asset-Einbettung auf dem Feature-Branch, der Kit selbst ist kein Produkt.
.shinon/tmp-blueprint/

# Messausgaben des Auslastungs-Werkzeugs (scripts/dev/auslastung.mjs): pro Lauf
# eine JSONL-Spur und eine Zusammenfassung unter .shinon/dev/. Belege, die
# bleiben sollen, wandern kuratiert nach docs/probes/ — der rohe Lauf ist
# Zustand, keine Quelle.
.shinon/dev/messung-*.jsonl
.shinon/dev/zusammenfassung-*.json

# Das Intent-Gedächtnis des Prompters (Fassung 2) wächst mit JEDEM Turn
# (Treffer, Klassen, Merkmale, Laufzeit, Folge-Rückmeldung). Projektwissen wie
# die gelernten Bausteine, aber Laufzeitzustand: kein Commit, kein Rauschen im
# Diff. Wer einen Stand als Beleg braucht, kopiert ihn kuratiert nach docs/probes/.
.shinon/intent-memory.json

# Das Probe-Journal der verworfenen One-Shot-Antworten (`probeJournalPath`):
# Nutzertext und Modellantwort im Klartext, angehaengt je Verwerfung. Es ist
# Messzustand, keine Quelle — kuratierte Auszuege wandern nach docs/probes/.
.shinon/one-shot-journal.jsonl

# Lernpruefung (SH-LEARN-03/04/06): das Vorschlagsregister, die Nutzungszaehlung,
# die Sicherungen des Skill-Writers und das Archiv des Curators. Alles Laufzeit-
# zustand EINES Projekts, kein Quelltext: ein Commit wuerde Vorschlaege und
# Nutzung einfrieren und den naechsten Lauf gegen einen alten Stand pruefen.
.shinon/learning-proposals.json
.shinon/learning-proposals.json.lock
.shinon/skill-usage.json
.shinon/skill-ledger.json
.shinon/skill-backups/
.shinon/learning-archive/

# SHINON.md ist eine KUNDENVORLAGE (SHINON.md.example im Root), keine lebendige
# Anweisung dieses Repos. Seit 2026-10-24 legt Shinon sie beim ersten Schritt in
# einem Workspace selbst an — im eigenen Baum ist das ein Artefakt, kein Inhalt.
/SHINON.md

# Credentials — never commit. Public repo!
.credentials.yaml

# Runtime- und Werkzeug-Reste (hinzugefuegt beim Artefakt-Aufraeumen).
logs/
*.log
**/.plugin-manager/logs/

# Python-Reste (das Repo ist Node-only, aber Werkzeuge fallen manchmal hierher).
__pycache__/
*.py[cod]
.pytest_cache/

# Freebuff workspace metadata.
.freebuff/

# Agent scratch is local work state, not source. Keep project instructions such
# as AGENTS.md and curated evidence under docs/probes/ versioned; ignore only
# dedicated root-level scratch/output locations and disposable probe scripts.
/.agent-work/
/.agent-cache/
/agent-output/
/scratch/
/tmp/
/temp/
/.pi-katalog-probe.mjs
/.facts-perf-probe.mjs

# OS- und Editor-Kram.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.orig
*.rej

# Umgebungen — nie committen. Vorlagen duerfen rein.
.env
.env.*
!.env.example

# Paket-/Testreste.
*.tgz
coverage/
.eslintcache
*.tsbuildinfo

# Session-Eval-Logs — nie committen (DSH-Session-Logs, Attachments, Tmp).
# Plan-Daten (.session-eval/*.md) bleiben absichtlich tracked.
.session-eval/logs-decompressed/
.session-eval/*.jsonl
.session-eval/*.zip
.session-eval/tmp/
attachments/

# Fremde Arbeitsnotizen — bewusst untracked, kein Teil des Repos.
# (Vergleichsanalysen anderer Projekte; ohne Statusblock, nicht Teil des
# kanonischen Doku-Satzes aus `AGENTS.md`.)
docs/FEATURE_ANALYSIS.md
docs/FEATURE_RANKING.md

# Installationspakete — gebaute Artefakte, nie eingecheckt. Der BAU gehoert
# in die CI (.github/workflows/package-build.yml): ein gebautes .deb oder
# Windows-ZIP ist ein Ergebnis, kein Quelltext. `dist-deb/`, `dist-win/` und
# `dist-package/` sind die Ausgabeverzeichnisse der beiden Bauern.
dist-deb/
dist-win/
dist-package/
dist-appimage/

# Laufzeit-Cache des Paketbaus (die geholte Node-Laufzeit des Archivs).
.cache/

# CI preflight report is generated per run and uploaded as a workflow artifact.
/preflight-report.json
/preflight-docs-report.json
