{
  "version": 1,
  "engine": {
    "always": [
      "bundle-resolution",
      "manifest",
      "contract",
      "patch",
      "host-half",
      "client-half",
      "legacy-guard",
      "profile",
      "typescript",
      "dsh-singleton"
    ],
    "local": [
      "bundle-resolution",
      "contract",
      "legacy-guard",
      "dsh-singleton"
    ],
    "slices": {
      "package-drift": {
        "prefixes": [
          "package.json",
          "packages/"
        ]
      },
      "duplicate-plugin": {
        "prefixes": [
          "packages/",
          "profiles/"
        ]
      },
      "dead-package": {
        "prefixes": [
          "packages/",
          "profiles/",
          "package.json"
        ]
      },
      "registry": {
        "prefixes": [
          "packages/",
          "profiles/"
        ]
      },
      "contracts": {
        "prefixes": [
          "docs/",
          "packages/"
        ]
      },
      "doctor": {
        "prefixes": [
          "package.json",
          "packages/",
          "profiles/",
          "scripts/"
        ]
      },
      "probe-twin": {
        "prefixes": [
          "docs/probes/",
          "packages/"
        ]
      },
      "persona": {
        "prefixes": [
          "packages/persona/",
          "profiles/"
        ]
      },
      "narrative": {
        "prefixes": [
          "packages/narrative/",
          "packages/persona/",
          "profiles/",
          "scripts/lib/repo.mjs",
          "scripts/gate/plugins/narrative.mjs",
          "scripts/gate/tests/narrative.test.mjs"
        ]
      },
      "events-spine": {
        "prefixes": [
          "packages/events/",
          "docs/contracts/events.json",
          "docs/probes/events-spine.json",
          "profiles/"
        ]
      },
      "scoring": {
        "prefixes": [
          "packages/scoring/",
          "scripts/gate/plugins/scoring.mjs",
          "scripts/gate/tests/scoring.test.mjs",
          "profiles/"
        ]
      },
      "markers": {
        "prefixes": [
          "packages/markers/",
          "docs/contracts/markers.json",
          "profiles/",
          "scripts/gate/plugins/markers.mjs",
          "scripts/gate/tests/markers.test.mjs"
        ]
      },
      "commit-trailer": {
        "prefixes": [
          "scripts/",
          ".github/",
          ".githooks/",
          "package.json",
          "docs/COMMIT-REGELN.md",
          "docs/contracts/commit-trailer.json",
          "docs/contracts/commit-policy.json",
          "AGENTS.md"
        ]
      }
    }
  }
}
