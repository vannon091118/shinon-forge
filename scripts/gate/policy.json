{
  "version": 1,
  "engine": {
    "always": [
      "manifest",
      "contract",
      "patch",
      "host-half",
      "client-half",
      "legacy-guard",
      "profile"
    ],
    "local": [
      "manifest",
      "contract",
      "patch",
      "host-half",
      "client-half",
      "legacy-guard",
      "profile"
    ],
    "slices": {
      "package-drift": {
        "prefixes": ["package.json", "packages/"]
      },
      "duplicate-plugin": {
        "prefixes": ["packages/", "profiles/"]
      },
      "dead-package": {
        "prefixes": ["packages/", "profiles/", "package.json"]
      },
      "registry": {
        "prefixes": ["packages/", "profiles/"]
      },
      "contracts": {
        "prefixes": ["docs/", "packages/"]
      },
      "doctor": {
        "prefixes": ["package.json", "packages/", "profiles/", "scripts/"]
      },
      "probe-twin": {
        "prefixes": ["docs/probes/", "packages/"]
      },
      "persona": {
        "prefixes": ["packages/persona/", "profiles/"]
      },
      "events-spine": {
        "prefixes": ["packages/events/", "docs/contracts/events.json", "docs/probes/events-spine.json", "profiles/"]
      },
      "markers": {
        "prefixes": ["packages/markers/", "docs/contracts/markers.json", "profiles/", "scripts/gate/plugins/markers.mjs", "scripts/gate/tests/markers.test.mjs"]
      },
      "commit-trailer": {
        "prefixes": ["scripts/", ".github/", ".githooks/", "package.json", "docs/COMMIT-REGELN.md", "docs/contracts/commit-trailer.json", "AGENTS.md"]
      }
    }
  }
}
