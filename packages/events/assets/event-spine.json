{
  "contract": "shinon.event-spine/v1",
  "version": 1,
  "authority": "NONE",
  "note": "Der Spine beobachtet, normalisiert, validiert und emittiert. Er entscheidet nichts, schreibt nichts und ruft kein Modell. authority:NONE ist die DOKI-Regel: abgeleitet ist nicht autoritativ.",
  "envelope": [
    "event_id",
    "event_type",
    "session_id",
    "source",
    "timestamp",
    "payload_ref",
    "contract",
    "trace_id"
  ],
  "derivation": {
    "event_id": {
      "prefix": "evt_",
      "length": 16,
      "digestOf": ["contract", "event_type", "session_id", "source", "timestamp", "payload_ref"]
    },
    "payload_ref": {
      "prefix": "sha256:",
      "length": 16,
      "digestOf": ["payload"]
    },
    "trace_id": {
      "prefix": "trc_",
      "length": 12,
      "digestOf": ["session_id", "event_type", "timestamp"]
    },
    "canonicalJson": "Objektschlüssel rekursiv sortiert, Arrays in Reihenfolge, keine Leerzeichen — gleicher Inhalt ergibt denselben Digest."
  },
  "session": {
    "paths": ["session_id", "sessionId", "session.id", "session"],
    "default": "",
    "note": "Leer = Event wird verworfen (fail-closed). Ein Standardwert darf nur bewusst im Profil gesetzt werden."
  },
  "trace": {
    "paths": ["trace_id", "traceId", "correlation_id", "correlationId"]
  },
  "signals": {
    "shinon/session/created": "session.created",
    "shinon/message/received": "message.received",
    "shinon/message/completed": "message.completed",
    "shinon/claim/created": "claim.created",
    "shinon/tool/requested": "tool.requested",
    "shinon/tool/completed": "tool.completed",
    "shinon/gate/passed": "gate.passed",
    "shinon/gate/failed": "gate.failed",
    "shinon/action/blocked": "action.blocked"
  },
  "carrier": {
    "signal": "session/event",
    "verified": true,
    "typePath": "type",
    "note": "Fünfzehn Typen, jeder gegen die installierte DSH-Fassung belegt (SessionEventMap) UND im Live-Lauf beobachtet. Die Payload-Pflichtfelder sind die echten DSH-Feldnamen: tool/call liefert name und arguments, tool/result liefert message — ein Feld 'tool' gibt es in DSH nicht.",
    "typeMap": {
      "session.created": "session.created",
      "user/message": "message.received",
      "assistant/message": "message.completed",
      "turn/start": "turn.start",
      "turn/end": "turn.end",
      "step/start": "step.start",
      "step/end": "step.end",
      "tool/call": "tool.requested",
      "tool/result": "tool.completed",
      "agent/inbox/spliced": "inbox.spliced",
      "request/header": "request.header",
      "developer/message": "developer.message",
      "system/message": "system.message",
      "workspace/changes": "workspace.changed",
      "session/title": "session.titled"
    },
    "verifiedTypes": [
      "session.created",
      "user/message",
      "assistant/message",
      "turn/start",
      "turn/end",
      "step/start",
      "step/end",
      "tool/call",
      "tool/result",
      "agent/inbox/spliced",
      "request/header",
      "developer/message",
      "system/message",
      "workspace/changes",
      "session/title"
    ],
    "ignoredTypes": [
      "assistant/attempt",
      "agent-preset/selected",
      "approval/asked",
      "approval/decided",
      "approval/policy",
      "command/run",
      "command/done",
      "compaction/start",
      "compaction/summary",
      "compaction/end",
      "compaction/prune",
      "feedback/record",
      "feedback/message-put",
      "feedback/message-delete",
      "goal/change",
      "image/offload",
      "llm/retry",
      "llm/retry-started",
      "model/selection",
      "permission/preset",
      "request/context",
      "sandbox/mode",
      "schedule/change",
      "session/end-seed",
      "subagent/catalog",
      "subagent/descriptor",
      "todo/write",
      "session/title-llm-request",
      "tool/ptc-dispatch",
      "tool/ptc-dispatch-start"
    ],
    "ignoredNote": "Bekannte DSH-Typen, die der Spine absichtlich NICHT abbildet. Sie werden still verworfen (kein onDrop, keine Warnung im Log) und in stats.ignored/ignoredTypes gezählt — sichtbar, aber ohne Log-Flut. Die Liste ist namentlich und vollständig für die installierte Fassung; ein NEUER DSH-Typ ist nicht hier und warnt deshalb weiter als UNKNOWN_SIGNAL. Ein Typ darf nie zugleich in typeMap und in ignoredTypes stehen."
  },
  "events": {
    "session.created": {
      "source": "dsh.session",
      "phase": "open",
      "payload": ["session_id"]
    },
    "message.received": {
      "source": "dsh.message",
      "phase": "input",
      "payload": ["session_id"]
    },
    "message.completed": {
      "source": "dsh.message",
      "phase": "output",
      "payload": ["session_id"]
    },
    "turn.start": {
      "source": "dsh.turn",
      "phase": "start",
      "payload": ["session_id"]
    },
    "turn.end": {
      "source": "dsh.turn",
      "phase": "end",
      "payload": ["session_id"]
    },
    "step.start": {
      "source": "dsh.step",
      "phase": "start",
      "payload": ["session_id"]
    },
    "step.end": {
      "source": "dsh.step",
      "phase": "end",
      "payload": ["session_id"]
    },
    "inbox.spliced": {
      "source": "dsh.inbox",
      "phase": "context",
      "payload": ["session_id"]
    },
    "request.header": {
      "source": "dsh.request",
      "phase": "metadata",
      "payload": ["session_id"]
    },
    "developer.message": {
      "source": "dsh.message",
      "phase": "context",
      "payload": ["session_id"]
    },
    "system.message": {
      "source": "dsh.message",
      "phase": "context",
      "payload": ["session_id"]
    },
    "workspace.changed": {
      "source": "dsh.workspace",
      "phase": "observation",
      "payload": ["session_id"]
    },
    "session.titled": {
      "source": "dsh.session",
      "phase": "metadata",
      "payload": ["session_id"]
    },
    "claim.created": {
      "source": "shinon.claims",
      "phase": "claim",
      "payload": ["session_id", "claim_id"]
    },
    "tool.requested": {
      "source": "dsh.tool",
      "phase": "action",
      "payload": ["session_id", "name"]
    },
    "tool.completed": {
      "source": "dsh.tool",
      "phase": "action",
      "payload": ["session_id", "message"]
    },
    "gate.passed": {
      "source": "shinon.gates",
      "phase": "verdict",
      "payload": ["session_id", "gate"]
    },
    "gate.failed": {
      "source": "shinon.gates",
      "phase": "verdict",
      "payload": ["session_id", "gate"]
    },
    "action.blocked": {
      "source": "shinon.policy",
      "phase": "verdict",
      "payload": ["session_id", "action", "reason"]
    }
  },
  "forbidden": [
    "autonomous_action",
    "decision",
    "state_mutation",
    "project_write",
    "model_call",
    "network_call"
  ]
}
